{
  "name": "campusos-hackathon",
  "version": "1.0.0",
  "description": "CampusOS — Intelligent university platform powered by an AI agent reading real-time campus data",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite",
    "migrate": "node server/db/migrate.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "test": "node server/tests/test_api_and_agent.js",
    "reset-data": "node server/scripts/resetData.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "vite": "^6.2.0"
  }
}
